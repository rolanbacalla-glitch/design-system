    "bg-action-primary-hover": {
      "$value": "{color.primary.30}",
      "$type": "color",
      "workbenchAlias": "--sys-primary-strong",
      "category": "action",
      "$description": "Primary interactive hover fill in Light mode"
    },
    "bg-action-primary-subtle": {
      "$value": "{color.primary.90}",
      "$type": "color",
      "workbenchAlias": "--sys-primary-container",
