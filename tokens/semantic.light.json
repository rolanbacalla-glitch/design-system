    "border-feedback-error": {
      "$value": "{color.feedback.error.40}",
      "$type": "color",
      "workbenchAlias": "--sys-error-border",
      "category": "feedback",
      "$description": "High-visibility border for invalid form fields (WCAG AA >= 4.5:1)"
