    "border-feedback-error": {
      "$value": "{color.feedback.error.70}",
      "$type": "color",
      "workbenchAlias": "--sys-error-border",
      "category": "feedback",
      "$description": "High-visibility border for invalid form fields (WCAG AA >= 5.8:1)"
