    "text-secondary": {
      "$value": "{color.neutral.70}",
      "$type": "color",
      "workbenchAlias": "--sys-on-surface-secondary",
      "category": "text",
      "$description": "Secondary supporting copy and field labels (WCAG AAA >= 8.1:1)"
