{
  "$schema": "https://tr.designtokens.org/format/",
  "meta": {
    "mode": "dark",
    "name": "Obsidian Dark",
    "tier": "Tier 2 — Alias / Semantic Tokens"
  },
  "semantic": {
    "bg-canvas": {
      "$value": "{color.neutral.6}",
      "$type": "color",
      "workbenchAlias": "--sys-surface-canvas",
      "category": "surface",
      "$description": "Z-Level 0 base environment canvas in Dark mode"
    },
    "bg-surface-recessed": {
      "$value": "{color.neutral.4}",
      "$type": "color",
      "workbenchAlias": "--sys-surface-lowest",
      "category": "surface",
