    "border-default": {
      "$value": "{color.neutral.60}",
      "$type": "color",
      "workbenchAlias": "--sys-outline-strong",
      "category": "border",
      "$description": "Standard structural control border (WCAG AA >= 5.4:1 UI contrast)"
    },
    "border-subtle": {
      "$value": "{color.neutral.22}",
      "$type": "color",
      "workbenchAlias": "--sys-outline-subtle",
      "category": "border",
      "$description": "Decorative hairline divider for bento cells and table rows"
    },
    "border-focus-ring": {
      "$value": "{color.primary.70}",
      "$type": "color",
      "workbenchAlias": "--sys-focus-ring",
      "category": "border",
      "$description": "WCAG 2.2 SC 2.4.11 focus-visible indicator ring (>= 8.4:1 contrast)"
